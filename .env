# Archivo .env (¡Asegúrate que no haya espacios al inicio o final de las líneas!)

# 1. Credenciales de Firebase (usa el nombre corto que elegiste en el paso 1)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# 2. URL de tu Base de Datos (cópiala de Firebase Console, sección Database/Realtime Database)
FIREBASE_DATABASE_URL="https://flia-ugb.firebaseio.com"

# 3. Clave secreta de Flask (puede ser cualquier cosa larga y aleatoria)
SECRET_KEY="una_clave_secreta_para_flask_que_debes_cambiar"